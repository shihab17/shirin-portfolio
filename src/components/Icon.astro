---
// Inline stroke icons for the marquee — no icon font, near-zero cost.
const icons: Record<string, string> = {
  reel: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10.5 9.5l4 2.5-4 2.5z"/>',
  story:
    '<path d="M12 6.5C10 4.8 7 4.5 4 5.5v13c3-1 6-.7 8 1 2-1.7 5-2 8-1v-13c-3-1-6-.7-8 1z"/><path d="M12 6.5v13"/>',
  edit: '<circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/><path d="M8.1 7.9L20 19.5M8.1 16.1L20 4.5"/>',
  ad: '<path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  color: '<path d="M12 3s6.5 6.3 6.5 11a6.5 6.5 0 0 1-13 0C5.5 9.3 12 3 12 3z"/>',
  motion: '<path d="M3 19c6 0 5-14 18-14"/><circle cx="3" cy="19" r="1.6"/><circle cx="21" cy="5" r="1.6"/>',
  sound: '<path d="M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4"/>',
  youtube: '<rect x="2.5" y="6" width="19" height="12.5" rx="3.5"/><path d="M10 9.7l5 2.55-5 2.55z"/>',
};

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
---

<svg
  class="mi"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
