---
import type { Category } from '../data/projects';

interface Props {
  id: string;
  title: string;
  kind: string;
  chips: string[];
  poster: string;
  src: string;
  description: string;
  category: Category;
  href?: string;
  vname?: string;
}

const { id, title, kind, chips, poster, src, description, category, href, vname } = Astro.props;
---

<article class="vcard" data-cat={category}>
  <div class="frame" style={`--poster:url("${poster}")${vname ? `;view-transition-name:work-${vname}` : ''}`}>
    <video
      id={`v${id}`}
      src={src}
      poster={poster}
      preload="none"
      playsinline
      controls
      controlslist="nodownload"
      aria-label={`${title} — ${description}`}
    ></video>
    <button class="play" type="button" aria-label={`Play ${title}`}><span></span></button>
    <span class="snd" aria-hidden="true">Tap for sound</span>
    <i class="glare"></i>
    <b class="num serif" aria-hidden="true">{id}</b>
  </div>
  <div class="meta">
    <div>
      <h3 class="serif">{href ? <a class="tlink" href={href}>{title}</a> : title}</h3>
      <p>{kind}</p>
    </div>
    <div class="chips">{chips.map((c) => <span>{c}</span>)}</div>
  </div>
</article>
